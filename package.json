{
  "name": "trs-80-simulator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The TRS-80 Model I (1977) in 3D in your browser: switch it on, type Level II BASIC, load tapes, open it up and watch the screen and keyboard work as memory.",
  "license": "Apache-2.0",
  "homepage": "https://wixette.github.io/trs-80-simulator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wixette/trs-80-simulator.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:refs": "node tools/check-refs.mjs",
    "check": "pnpm check:refs && pnpm typecheck && pnpm test",
    "test": "node --test \"tests/**/*.test.js\" \"tools/*.test.mjs\"",
    "test:zexdoc": "ZEXDOC=1 node --test tests/cpu.zexdoc.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "vendor": "node tools/vendor.mjs",
    "stamp": "node tools/stamp.mjs",
    "version": "node tools/stamp.mjs",
    "serve": "node tools/serve.mjs 8000",
    "build:model": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --factory-startup --python-exit-code 1 --python model/blender/scripts/build_desk.py",
    "params": "python3 -I tools/kicad_to_params.py"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@material-symbols/svg-400": "0.48.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "typescript": "7.0.2"
  }
}
